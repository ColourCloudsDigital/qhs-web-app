# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USER=qaras_user
DATABASE_PASSWORD=qaras_password
DATABASE_NAME=qaras_hotel
DATABASE_URL=mysql://qaras_user:qaras_password@localhost:3306/qaras_hotel

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your-secret-key-here

# Application URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Brevo Email Service Configuration
BREVO_API_KEY=your-brevo-api-key-here
BREVO_SENDER_EMAIL=noreply@yourdomain.com
BREVO_SENDER_NAME=Qaras Hotels

# Brevo Template IDs
BREVO_TEMPLATE_EMAIL_VERIFICATION=1
BREVO_TEMPLATE_PASSWORD_RESET=2
BREVO_TEMPLATE_WELCOME_EMAIL=3
BREVO_TEMPLATE_BOOKING_CONFIRMATION=4

# SMTP Configuration (Fallback)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=your-brevo-email@example.com
SMTP_PASSWORD=your-brevo-smtp-key
EMAIL_FROM_NAME=Qaras Hotels
EMAIL_FROM_ADDRESS=noreply@yourdomain.com

# Payment Gateway
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# PWA
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Contact
CONTACT_EMAIL=info@qarashotels.com
